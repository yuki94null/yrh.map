$execute as @e[type=minecraft:interaction,tag=yrh.map.worldmap_anchor,scores={yrh_map_id=$(map_id)},distance=..9,limit=1] at @s if data entity @s data.yrhmap{Owner:$(player),Pinned:1b} run return run function yrh.map:function/worldmap/input/run_map_control {action:"unpin_map",message:"yrh.map.unpinned",fallback:"地図の固定を解除しました",player:$(player)}
$execute as @e[type=minecraft:interaction,tag=yrh.map.worldmap_anchor,scores={yrh_map_id=$(map_id)},distance=..9,limit=1] at @s if data entity @s data.yrhmap{Owner:$(player)} run return run function yrh.map:function/worldmap/input/run_map_control {action:"toggle_pin",message:"yrh.map.pinned",fallback:"地図を固定しました",player:$(player)}
$title @a[nbt={UUID:$(player)},limit=1] actionbar {translate:"yrh.map.cannot_operate",fallback:"この地図は操作できません",color:"red"}
