$execute unless entity @e[type=minecraft:interaction,tag=yrh.map.worldmap_anchor,tag=!yrh.map.rim_controls_hidden,scores={yrh_map_id=$(map_id)},limit=1] run return 0
$execute if data storage yrh.map:_ worldmap.button_event{side:"left"} run return run tellraw @a[nbt={UUID:$(player)},limit=1] [{text:"X: $(x)  Z: $(z)",click_event:{action:"copy_to_clipboard",value:"$(x) $(z)"},hover_event:{action:"show_text",value:{text:"X・Z座標をコピー"}}},{text:" [TP]",color:"aqua",click_event:{action:"suggest_command",command:"/function yrh.map:function/worldmap/waypoint/markers/teleport {x:$(x),z:$(z)}"}}]
$execute if score #map_click_access yrh_map_tmp matches 2 as @e[type=minecraft:interaction,tag=yrh.map.worldmap_anchor,scores={yrh_map_id=$(map_id)},limit=1] at @s if data entity @s data.yrhmap.WaypointPlacement run return run function yrh.map:function/worldmap/waypoint/placement/click
$execute as @e[type=minecraft:interaction,tag=yrh.map.worldmap_anchor,scores={yrh_map_id=$(map_id)},limit=1] at @s run function yrh.map:function/worldmap/waypoint/markers/center_marker
